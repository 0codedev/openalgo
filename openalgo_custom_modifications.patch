-# Strategy Parameters
-FAST_EMA_PERIOD = int(os.getenv("FAST_EMA_PERIOD", "2"))
-SLOW_EMA_PERIOD = int(os.getenv("SLOW_EMA_PERIOD", "4"))
-CANDLE_TIMEFRAME = os.getenv("CANDLE_TIMEFRAME", "5m")
