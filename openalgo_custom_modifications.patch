+                  the specified time.
+                </p>
+              </div>
+            )}
+
+            {/* Submit */}
+            <div className="flex gap-3 pt-4">
+              <Button
+                type="button"
+                variant="outline"
+                className="flex-1"
+                onClick={() => navigate('/strategy')}
+              >
+                Cancel
