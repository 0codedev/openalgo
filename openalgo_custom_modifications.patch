-            )
-            while not self.stop_event.is_set():
-                time.sleep(1)
-        except Exception as e:
-            print(f"[ERROR] WebSocket error: {e}")
-        finally:
-            try:
-                self.client.unsubscribe_ltp(self.instrument)
-                self.client.disconnect()
-            except Exception:
-                pass
