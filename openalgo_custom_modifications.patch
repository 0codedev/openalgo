+      showToast.error(errorMessage, 'strategy')
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  const finalName =
+    formData.platform && formData.name
+      ? `${formData.platform}_${formData.name.toLowerCase().replace(/\s+/g, '_')}`
+      : ''
+
+  return (
