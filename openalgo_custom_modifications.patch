+                  <TableHead>Symbol</TableHead>
+                  <TableHead>Exchange</TableHead>
+                  <TableHead className="text-right">Quantity</TableHead>
+                  <TableHead>Product</TableHead>
+                  <TableHead className="w-16"></TableHead>
