-  color: var(--oscript-number);
-}
-/* A hexadecimal colour literal. It is a literal like a number and not like a
-   name, which is what it used to be painted as: the token's kind is hexColor,
-   and a rule that asked whether a kind was made of letters answered yes to it. */
-.oscript-color {
-  color: var(--oscript-color);
-}
-.oscript-keyword {
-  color: var(--oscript-keyword);
-}
-/* A function the language provides: plot, ema, input. */
