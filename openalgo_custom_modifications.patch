+      newErrors.name = 'Name must be between 3 and 50 characters'
+    } else if (!/^[a-zA-Z0-9\s\-_]+$/.test(formData.name)) {
+      newErrors.name = 'Name can only contain letters, numbers, spaces, hyphens, and underscores'
